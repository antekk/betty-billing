# Database
DATABASE_URL=postgresql://betty:betty@localhost:5432/betty

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-me-to-another-random-secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxx

# Encryption (for PHN storage - generate with: openssl rand -hex 32)
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# SMS Provider (mock for v1)
SMS_PROVIDER=mock

# Twilio (required when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+15875550100

# Web Push (optional — generate keys with: bunx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.example

# Proactive billing-gap reminder (days without billing before Betty checks in)
# BILLING_REMINDER_DAYS=7
